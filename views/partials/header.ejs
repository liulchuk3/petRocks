      ap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </div>

    <div class="lang-switcher">
  <button class="lang-current" id="lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Перемикач мови">
    <svg class="planet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
  </button>
  
  <ul class="lang-dropdown">
    <li><button class="lang-option" id="lang-en" data-lang="en">En</button></li>
    <li><button class="lang-option" id="lang-uk" data-lang="uk">Укр</button></li>
  </ul>
</div>

  </div>

</button>
    <a href="/<%= currentLng %>" class="logo">
        <img 
            src="/images/petRocksLogoLight.png" 
            alt="Pet Rocks Логотип" 
            class="site-logo"
            id="site-logo"
        />
    </a>

    <% if (userData) { %>
      <div class="header-profile">
        <a href="/<%= currentLng %>/profile" class="header-profile-link1200">
          <p class="sidebar-username-avatar"></p>
          <p class="sidebar-username-name"><%= t('profile.tab-info') %></p>
        </a>
      </div>
    <% } else { %>
      <div class="header-profile">
      <a href="/<%= currentLng %>/authorization-sign-in" class="header-sign-in1200"><%= t('global.sign-in') %></a>
      </div>
    <% } %>

    <button id="header-sidebar-open-btn" class="openButton">&#9776;</button>

</header>