<aside id="sidebar" class="sidebar">
        <button id="sidebar-sidebar-close-btn" class="sidebar-sidebar-close-btn">✖</button>
        
        <a href="/<%= currentLng %>/authorization-sign-in" class="sidebar-sign-in"><%= t('global.sign-in') %></a>

    <label for="language" class="sidebar-language-label"><%= t('global.language') %></label>
    <select id="language" name="language" class="sidebar-language-select">
        <option value="en" <%= currentLng === 'en' ? 'selected' : '' %>>English</option>
        <option value="uk" <%= currentLng === 'uk' ? 'selected' : '' %>>Українська</option>
    </select>

    <p class="sidebar-description-navigation"><%= t('global.navigation-heading') %></p>
    <nav class="sidebar-nav" aria-label="Sidebar Navigation">
        <a href="/<%= currentLng %>/catalog" class="sidebar-link"><%= t('global.navigation.catalog') %></a>
        <a href="/<%= currentLng %>/home" class="sidebar-link"><%= t('global.navigation.home') %></a>
        <a href="/<%= currentLng %>/about" class="sidebar-link"><%= t('global.navigation.about') %></a>
        <a href="/<%= currentLng %>/contact" class="sidebar-link"><%= t('global.navigation.contact') %></a>
    </nav>
</aside>

<div id="overlay" class="overlay"></div>