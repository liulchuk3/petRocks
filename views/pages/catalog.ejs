<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/catalog.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/cart') %>
    <%- include('../partials/sidebar') %>

    <main>
        
        <div class="sort-filter-div">
            <button id="filter" class="sort-filter-btn"><%= t('catalog.filter-sort') %></button>
            <div class="sort-filter-box">
                <form method="GET" action="/<%= currentLng %>/catalog">
                    <div class="form-div">
                        <div class="filter-form-part form-part">
                            <h2><%= t('catalog.filter') %></h2>
                            <h3><%= t('catalog.price-range') %></h3>
                            <div class="min-max-price">
                                <div>
                                    <input type="number" id="min-price" name="min-price" placeholder="<%= t('catalog.form.min-price') %>" value="<%= selectedFilters?.minPrice ?? '' %>">
                                </div>
                                <div>
                                    <input type="number" id="max-price" name="max-price" placeholder="<%= t('catalog.form.max-price') %>" value="<%= selectedFilters?.maxPrice ?? '' %>">
                                </div>
                            </div>
                        </div>

                        <div class="sort-form-part form-part">
                            <h2><%= t('catalog.sort') %></h2>
                            <h3><%= t('catalog.sort-by-price') %></h3>
                            <select name="sort-by-price" id="sort">
                                <option value=""><%= t('catalog.sort-by-price') %></option>
                                <option value="desc" <%= selectedFilters?.sortByPrice === 'desc' ? 'selected' : '' %>><%= t('catalog.sort-desc') %></option>
                                <option value="asc" <%= selectedFilters?.sortByPrice === 'asc' ? 'selected' : '' %>><%= t('catalog.sort-asc') %></option>
                                <option value="discount" <%= selectedFilters?.sortByPrice === 'discount' ? 'selected' : '' %>><%= t('catalog.sort-discount') %></option>
                            </select>
                            <h3><%= t('catalog.sort-by-date') %></h3>
                            <select name="sort-by-date" id="sort-by-date">
                                <option value=""><%= t('catalog.sort-by-date') %></option>
                                <option value="newest" <%= selectedFilters?.sortByDate === 'newest' ? 'selected' : '' %>><%= t('catalog.sort-newest') %></option>
                                <option value="oldest" <%= selectedFilters?.sortByDate === 'oldest' ? 'selected' : '' %>><%= t('catalog.sort-oldest') %></option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="apply-btn"><%= t('catalog.apply') %></button>
                </form>
                <button class="close-sort-filter"><%= t('catalog.close') %></button>
            </div>
        </div>
        <div class="catalog-card-container">
            <% items.forEach(item => { %>
                <div class="<% if (item.isActive) { %>catalog-rock-card<% } else { %>catalog-rock-card inactive<% } %>">
                    <a href="/<%= currentLng %>/rock/<%= item.slug %>" class="catalog-rock-card-image-link">
                        <img src="<%= item.imageUrl %>" alt="<%= item.name[currentLng] || item.name.en %>">
                    </a>
                    <h2>
                        <a href="/<%= currentLng %>/rock/<%= item.slug %>" class="catalog-rock-card-title-link"><%= item.name[currentLng] || item.name.en %></a>
                    </h2>
                    <% if (item.discountPrice && item.discountPrice < item.price) { %>
                            <p class="price"></span> $<%= item.discountPrice %> <span class="original-price">$<%= item.price %></p>
                        <% } else { %>
                            <p class="price">$<%= item.price %></p>
                        <% } %>
                    <button class="<% if(item.isActive){ %>add-to-cart-btn<% } else { %>add-to-cart-btn inactive<% } %>" data-rock-id="<%= item.id %>"><%= t('global.add-to-cart') %></button>
                </div>
            <% }) %>
        </div>

    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/catalog.js" type="module"></script>
</body>
</html>