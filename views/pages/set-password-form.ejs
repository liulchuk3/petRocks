<!DOCTYPE html>
<html lang="<%= currentLng %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/set-password-form.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <main>
        <section class="password-reset" aria-labelledby="password-reset-title">
            <div class="password-reset__eyebrow"><%= t('passwordReset.eyebrow') %></div>
            <h1 id="password-reset-title" class="password-reset__title"><%= t('passwordReset.heading') %></h1>
            <p class="password-reset__intro"><%= t('passwordReset.description') %></p>
            <form id="setPasswordForm" class="password-reset__form"
                data-language="<%= currentLng %>"
                data-password-mismatch="<%= t('passwordReset.password-mismatch') %>"
                data-request-failed="<%= t('passwordReset.request-failed') %>"
                data-success="<%= t('passwordReset.success') %>"
                data-network-error="<%= t('passwordReset.network-error') %>">
                <label class="password-reset__label" for="newPasswordInput"><%= t('passwordReset.new-password') %></label>
                <input class="password-reset__input" type="password" id="newPasswordInput" placeholder="<%= t('passwordReset.new-password-placeholder') %>" autocomplete="new-password" minlength="8" required>
                <label class="password-reset__label" for="confirmPasswordInput"><%= t('passwordReset.confirm-password') %></label>
                <input class="password-reset__input" type="password" id="confirmPasswordInput" placeholder="<%= t('passwordReset.confirm-password-placeholder') %>" autocomplete="new-password" minlength="8" required>
                <input type="hidden" id="tokenInput" value="<%= token %>">
                <p class="password-reset__message" id="passwordResetMessage" role="status" aria-live="polite" hidden></p>
                <button class="password-reset__submit" type="submit">
                    <span class="password-reset__submit-label"><%= t('passwordReset.submit') %></span>
                    <span class="password-reset__spinner" aria-hidden="true"></span>
                </button>
            </form>
            <a class="password-reset__back" href="/<%= currentLng %>/authorization-sign-in"><%= t('passwordReset.back-to-sign-in') %></a>
        </section>
    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/home.js" type="module"></script>
<script src="/js/set-password-form.js" type="module"></script>
</body>
</html>