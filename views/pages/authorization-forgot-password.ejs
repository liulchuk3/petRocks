<!DOCTYPE html>
<html lang="<%= currentLng %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/authorization.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <main>
        <section class="auth-panel" aria-labelledby="auth-title">
            <div class="auth-eyebrow"><%= t('authorization.eyebrow') %></div>
            <h1 id="auth-title" class="authorization-title"><%= t('authorization.forgot-password-heading') %></h1>
            <p class="authorization-instruction"><%= t('authorization.forgot-password-instruction') %></p>
            <form id="forgotPasswordForm" class="authorization-form" data-success="<%= t('authorization.forgot-password-success') %>" data-error="<%= t('authorization.form-error') %>" data-network-error="<%= t('authorization.network-error') %>">
                <label class="auth-label" for="emailInput"><%= t('authorization.email-placeholder') %></label>
                <input class="auth-input" type="email" id="emailInput" name="email" placeholder="<%= t('authorization.email-placeholder') %>" autocomplete="email" required>
                <p id="formError" class="form-error" role="status" aria-live="polite" hidden></p>
                <button class="auth-submit" type="submit" id="forgotPasswordButton"><span><%= t('authorization.forgot-password-button') %></span><span class="auth-spinner" aria-hidden="true"></span></button>
            </form>
            <div class="auth-switch">
                <p><%= t('authorization.remember-password') %></p>
                <a href="/<%= currentLng %>/authorization-sign-in"><%= t('authorization.sign-in-link') %></a>
            </div>
        </section>
        
    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/forgot-password.js" type="module"></script>
</body>
</html>