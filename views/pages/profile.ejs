<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <main>
        <div class="profile-container">

            <%# ── Заголовок ──────────────────────────────────────── %>
            <% if (userData.username) { %>
                <h1 class="profile-h"><%= t("profile.hello") %>, <%= userData.username %>!</h1>
            <% } else { %>
                <h1 class="profile-h"><%= t("profile.hello-v2") %></h1>
            <% } %>

            <%# ── Вкладки ─────────────────────────────────────────── %>
            <div class="profile-tabs">
                <button class="profile-tab active" data-tab="info"><%= t("profile.tab-info") %></button>
                <button class="profile-tab" data-tab="cart"><%= t("profile.tab-cart") %> <span class="tab-badge" id="cart-badge"></span></button>
                <button class="profile-tab" data-tab="likes"><%= t("profile.tab-likes") %> <span class="tab-badge" id="likes-badge"></span></button>
            </div>

            <%# ── Панель: Профіль ────────────────────────────────── %>
            <div class="profile-panel active" id="panel-info">
                <div class="profile-info">
                    <img class="profile-picture"
                        src="<%= userData.imageUrl ? userData.imageUrl : '/images/default-avatar.svg' %>"
                        alt="Profile Picture">
                    <div class="profile-details">
                        <p><strong><%= t("profile.userId") %>:</strong> <%= userData.id %></p>
                        <% if (userData.username) { %>
                            <p><strong><%= t("profile.username") %>:</strong> <%= userData.username %></p>
                        <% } else { %>
                            <p><strong><%= t("profile.username") %>:</strong>
                                <a href="#"><%= t("profile.no-username-link") %></a>
                            </p>
                        <% } %>
                        <p><strong><%= t("profile.email") %>:</strong> <%= userData.email %></p>
                    </div>
                </div>
            </div>

            <%# ── Панель: Кошик ──────────────────────────────────── %>
            <div class="profile-panel" id="panel-cart">
                <div class="profile-panel-inner" id="cart-content">
                    <p class="panel-loading"><%= t("profile.loading") %></p>
                </div>
                <div class="cart-total" id="cart-total" style="display:none;">
                    <strong><%= t("profile.total") %>: </strong><span id="cart-total-value">$0.00</span>
                </div>
            </div>

            <%# ── Панель: Уподобання ─────────────────────────────── %>
            <div class="profile-panel" id="panel-likes">
                <div class="profile-panel-inner" id="likes-content">
                    <p class="panel-loading"><%= t("profile.loading") %></p>
                </div>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>

    <%# Передаємо i18n рядки в JS через data-атрибути %>
    <div id="profile-i18n" hidden
        data-loading="<%= t('profile.loading') %>"
        data-cart-empty="<%= t('profile.cart-empty') %>"
        data-likes-empty="<%= t('profile.likes-empty') %>"
        data-items-empty="<%= t('profile.items-empty') %>"
        data-total="<%= t('profile.total') %>"
        data-quantity="<%= t('profile.quantity') %>"
        data-remove="<%= t('profile.remove') %>"
        data-in-stock="<%= t('profile.in-stock') %>"
        data-price="<%= t('profile.price') %>"
    ></div>

    <script src="/js/index.js" type="module"></script>
    <script src="/js/profile.js" type="module"></script>
</body>
</html>
