<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <main>
        <h1><%= t('index.h1-part-one') %> <br> <span><%= t('index.h1-part-two') %></span></h1>
        <p class="home-p-description1"><%= t('index.p-description') %></p>

        <a href="#catalog" class="catalog-heading"><%= t('index.catalog-heading') %></a>

        <a href="" class="collection-a"><h2 class="collection-h"><%= t('index.our-hits-heading') %></h2></a>
        <div class="rocks-wrapper">
            <button class="scroll-btn scroll-btn-top-left" aria-label="Scroll left">&#8249;</button>

            <div class="rocks-container top-rocks-container">
                <% items.forEach(item => { %>
                    <div class="rock-card">
                        <a href="/product/<%= item.id %>" class="rock-card-image-link">
                            <img src="<%= item.imageUrl %>" alt="<%= item.name %>">
                        </a>
                        <h2>
                            <a href="/product/<%= item.id %>" class="rock-card-title-link"><%= item.name %></a>
                        </h2>
                        <p class="price">$<%= item.price %></p>
                        <button class="add-to-cart-btn" data-rock-id="<%= item.id %>">Add to Cart</button>
                    </div>
                <% }) %>
            </div>

            <button class="scroll-btn scroll-btn-top-right" aria-label="Scroll right">&#8250;</button>
        </div>

        <div class="home-p-description2">
            <p><%= t('index.p-description2') %></p>
        </div>

        <a href="" class="collection-a"><h2 class="collection-h"><%= t('index.new-arrivals-heading') %></h2></a>
        <div class="rocks-wrapper">
            <button class="scroll-btn scroll-btn-bottom-left" aria-label="Scroll left">&#8249;</button>

            <div class="rocks-container bottom-rocks-container">
                <% items.forEach(item => { %>
                    <div class="rock-card">
                        <a href="/product/<%= item.id %>" class="rock-card-image-link">
                            <img src="<%= item.imageUrl %>" alt="<%= item.name %>">
                        </a>
                        <h2>
                            <a href="/product/<%= item.id %>" class="rock-card-title-link"><%= item.name %></a>
                        </h2>
                        <p class="price">$<%= item.price %></p>
                        <button class="add-to-cart-btn" data-rock-id="<%= item.id %>">Add to Cart</button>
                    </div>
                <% }) %>
            </div>

            <button class="scroll-btn scroll-btn-bottom-right" aria-label="Scroll right">&#8250;</button>
        </div>

        <a href="#catalog" class="catalog-heading"><%= t('index.catalog-heading') %></a>

        <hr>

        <div class="terms">
            <div class="terms-div">
                <p class="terms-img terms-icon-1"></p>
                <p class="terms-text"><%= t('index.pay-after-delivery') %></p>
            </div>
            <div class="terms-div">
                <p class="terms-img terms-icon-2"></p>
                <p class="terms-text"><%= t('index.free-shipping') %></p>
            </div>
            <div class="terms-div">
                <p class="terms-img terms-icon-3"></p>
                <p class="terms-text"><%= t('index.money-back-guarantee') %></p>
            </div>
            <div class="terms-div">
                <p class="terms-img terms-icon-4"></p>
                <p class="terms-text"><%= t('index.quality-assurance') %></p>
            </div>
        </div>
        
    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/home.js" type="module"></script>
</body>
</html>