<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/item-page.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/cart') %>
    <%- include('../partials/sidebar') %>

    <main class="item-page-main">
        <section class="item-hero">
            <img class="item-hero__image" src="<%= item.imageUrl %>" alt="Товар Pet Rocks" />
            <div class="item-hero__content">
                
                <h1 class="item-hero__title"><%= item.name[currentLng] || item.name.en %></h1>
                
                <p class="item-hero__price">$<%= item.price %></p>
                <p class="description-text1200"><%= item.description[currentLng] || item.description.en %></p>
                <div class="item-actions">
                    <% const currentItemInCart = Array.isArray(userCart) && userCart.some(cartItem => cartItem?.item?.id === item.id || cartItem?.itemId === item.id); %>
                    <button type="button" class="add-to-cart-btn <%= currentItemInCart ? 'in-cart' : '' %>" data-rock-id="<%= item.id %>"><%= currentItemInCart ? (currentLng === 'uk' ? 'У кошику' : 'In cart') : (currentLng === 'uk' ? 'Додати в кошик' : 'Add to cart') %></button>
                </div>

                <div class="description-wrapper" id="desc-wrapper">
                    <p class="description-text" id="desc-text"><%= item.description[currentLng] || item.description.en %></p>
                    <button class="read-more-toggle" id="desc-toggle" type="button"><%= t('itemPage.read-more') %></button>
                </div>

            </div>
        </section>

        <section class="item-details">
            <article class="item-card">
                <h2><%= t('itemPage.advantages') %></h2>
                <ul>
                    <li><%= t('itemPage.advangate1') %></li>
                    <li><%= t('itemPage.advangate2') %></li>
                    <li><%= t('itemPage.advangate3') %></li>
                </ul>
            </article>
            <article class="item-card">
                <h2><%= t('itemPage.how-to-care') %></h2>
                <p><%= t('itemPage.care-instructions') %></p>
            </article>
                </ul>
        </section>

            <a href="/<%= currentLng %>/catalog" class="collection-a"><h2 class="collection-h"><%= t('itemPage.more-rocks') %></h2></a>
            <div class="rocks-wrapper">
                <button class="scroll-btn scroll-btn-top-left" aria-label="Scroll left">&#8249;</button>

                <div class="rocks-container top-rocks-container">
                    <% items.hitItems.forEach(item => { %>
                        <div class="rock-card rock-card-animation">
                            <a href="/<%= currentLng %>/rock/<%= item.slug %>" class="rock-card-image-link">
                                <img src="<%= item.imageUrl %>" alt="<%= item.name[currentLng] || item.name.en %>">
                            </a>
                            <h2>
                                <a href="/<%= currentLng %>/rock/<%= item.slug %>" class="rock-card-title-link"><%= item.name[currentLng] || item.name.en %></a>
                            </h2>
                            <% if (item.discountPrice && item.discountPrice < item.price) { %>
                            <p class="price"></span> $<%= item.discountPrice %> <span class="original-price">$<%= item.price %></p>
                            <% } else { %>
                                <p class="price">$<%= item.price %></p>
                            <% } %>
                            <% const relatedItemInCart = Array.isArray(userCart) && userCart.some(cartItem => cartItem?.item?.id === item.id || cartItem?.itemId === item.id); %>
                            <button type="button" class="add-to-cart-btn2 <%= relatedItemInCart ? 'in-cart' : '' %>" data-rock-id="<%= item.id %>"><%= relatedItemInCart ? (currentLng === 'uk' ? 'У кошику' : 'In cart') : (currentLng === 'uk' ? 'Додати в кошик' : 'Add to cart') %></button>
                        </div>
                    <% }) %>
                </div>

            <button class="scroll-btn scroll-btn-top-right" aria-label="Scroll right">&#8250;</button>
        </div>
    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/item-page.js" type="module"></script>
</body>
</html>