<!DOCTYPE html>
<html lang="<%= currentLng %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/headLinks') %>
    <link rel="stylesheet" href="/css/authorization.css">
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>

    <main>
        <section class="auth-panel" aria-labelledby="auth-title">
            <div class="auth-eyebrow"><%= t('authorization.eyebrow') %></div>
            <h1 id="auth-title" class="authorization-title"><%= t('authorization.sign-up-heading') %></h1>
            <p class="auth-description"><%= t('authorization.sign-up-description') %></p>
            <form id="registerForm" class="authorization-form" data-fill-error="<%= t('authorization.fill-error') %>" data-invalid-email="<%= t('authorization.invalid-email') %>" data-short-password="<%= t('authorization.short-password') %>" data-password-mismatch="<%= t('authorization.password-mismatch') %>" data-network-error="<%= t('authorization.network-error') %>" data-generic-error="<%= t('authorization.form-error') %>">
                <label class="auth-label" for="email"><%= t('authorization.email-placeholder') %></label>
                <input class="auth-input" type="email" id="email" name="email" placeholder="<%= t('authorization.email-placeholder') %>" autocomplete="email" required>
                <label class="auth-label" for="password"><%= t('authorization.password-placeholder') %></label>
                <input class="auth-input" type="password" id="password" name="password" placeholder="<%= t('authorization.password-placeholder') %>" autocomplete="new-password" required minlength="8">
                <label class="auth-label" for="confirmPassword"><%= t('authorization.password-confirmation-placeholder') %></label>
                <input class="auth-input" type="password" id="confirmPassword" name="confirmPassword" placeholder="<%= t('authorization.password-confirmation-placeholder') %>" autocomplete="new-password" required>
                <p id="formError" class="form-error" role="status" aria-live="polite" hidden></p>
                <button class="auth-submit" type="submit"><span><%= t('authorization.sign-up-button') %></span><span class="auth-spinner" aria-hidden="true"></span></button>
            </form>
            <div class="auth-switch">
                <p><%= t('authorization.already-have-account') %></p>
                <a href="/<%= currentLng %>/authorization-sign-in"><%= t('authorization.sign-in-link') %></a>
            </div>
        </section>
        
    </main>

    <%- include('../partials/footer') %>
<script src="/js/index.js" type="module"></script>
<script src="/js/register.js" type="module"></script>
</body>
</html>