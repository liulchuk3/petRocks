// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING    // Очікує обробки
  CONFIRMED  // Підтверджено
  SHIPPED    // Відправлено
  DELIVERED  // Доставлено
  CANCELLED  // Скасовано
}

model Items {
  id            Int          @id @default(autoincrement())
  sku           String       @unique
  slug          String       @unique
  name          Json
  description   Json

  price         Decimal      @db.Decimal(10, 2)
  discountPrice Decimal?     @db.Decimal(10, 2)

  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])

  stock         Int          @default(1)
  isActive      Boolean      @default(true)
  imageUrl      String

  cartItems     CartItem[]
  orderItems    OrderItem[]  // замість likes

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          String         @default("USER")
  username      String?
  imageUrl      String?
  refreshTokens RefreshToken[]
  items         Items[]
  cartItems     CartItem[]
  orders        Order[]        // замовлення користувача
  createdAt     DateTime       @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Items    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model Order {
  id          Int         @id @default(autoincrement())

  // Користувач — опціональний, бо замовлення може бути без реєстрації
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Контактні дані для доставки
  email       String      // пошта на яку прийде підтвердження
  firstName   String
  lastName    String
  phone       String?

  status      OrderStatus @default(PENDING)
  totalPrice  Decimal     @db.Decimal(10, 2)

  orderItems  OrderItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Items   @relation(fields: [itemId], references: [id], onDelete: Restrict) // Restrict — не дає видалити товар якщо він є в замовленні
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2) // ціна на момент замовлення (фіксуємо!)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}